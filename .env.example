# Copie para .env e preencha. O .env está no .gitignore: nunca o commite.

# Token do dispositivo simulador (sim-001), com pelo menos 24 caracteres. Gere um novo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# O banco guarda só o SHA-256 dele. Os tokens que estiveram no código do v1 são recusados.
DEVICE_TOKEN=

# Porta HTTP do serve. Porta ocupada é erro: não há troca automática.
PORT=8000

# Interface de escuta: 127.0.0.1 só nesta máquina; 0.0.0.0 para a rede (o Docker usa 0.0.0.0).
HOST=127.0.0.1

# Banco SQLite: caminho relativo à raiz do projeto ou absoluto.
DB_PATH=data/irrigacao.db

# Origem autorizada para CORS, por exemplo https://meu-dominio.org (vazio = só a origem do próprio painel).
CORS_ORIGIN=
